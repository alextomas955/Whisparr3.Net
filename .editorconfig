# EditorConfig - root. https://aka.ms/editorconfigdocs
root = true

# ---------- All files ----------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,md,cjs,mjs,ts,tsx,js,jsx}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

# ---------- Generated code ----------
# src/Whisparr3.Net/ is openapi-generator output from Phase 20 on. This section must stay LAST,
# because a narrower section placed above the general ones would apply to almost nothing.
#
# What this setting does, measured: it covers ANALYZER diagnostics (CAxxxx, IDExxxx) over the
# generated files that carry no // <auto-generated> header. It suppresses no compiler diagnostic
# at all. The NoWarn line in Directory.Build.props is what actually makes the zero-warning policy
# survivable.
[src/Whisparr3.Net/**]
generated_code = true
