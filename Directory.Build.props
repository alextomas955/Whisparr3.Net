<Project>

  <!-- Compilation. Owned here because the library csproj is generator output from Phase 20 on. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS0612: the spec's own deprecated: true on QueueResource.Sizeleft/Timeleft.
         CS1591: missing XML comments, insurance for the hand-written layer. -->
    <NoWarn>$(NoWarn);CS0612;CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Deterministic build and symbols. Deterministic already defaults to true; do not set it.
       Do not reference Microsoft.SourceLink.GitHub; it suppresses the SDK's built-in copy. -->
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- SourceLink reads origin, the only remote a clone is guaranteed to have.

       The problem this solves: origin here is the git@github.com-alex SSH alias, and the SDK
       does not recognise that host, so it emits no source map at all and ships a dead .snupkg,
       silently and with no warning. Pointing GitRepositoryRemoteName at a hand-added canonical
       remote fixed it only on the one machine where someone typed git remote add by hand; every
       clone, including the owner's second machine and CI, has only origin and got two fallback
       warnings per project per build.

       Registering the alias as a GitHub host is repo-tracked, so it works in every clone.
       Measured on SDK 10.0.400, packing this props file with each remote in turn as the only
       remote:
         origin https://github.com/...            0 warnings, source map to raw.githubusercontent.com
         origin git@github.com-alex:...           0 warnings, source map to raw.githubusercontent.com
       Without the mapping the second case emits no .sourcelink.json and writes
       url="ssh://git@github.com-alex/..." into the nuspec. -->
  <ItemGroup>
    <SourceLinkGitHubHost Include="github.com-alex" ContentUrl="https://raw.githubusercontent.com" />
  </ItemGroup>

  <!-- NuGet package metadata. RepositoryUrl and RepositoryType are deliberately absent;
       SourceLink injects both plus the commit SHA from PublishRepositoryUrl=true. -->
  <PropertyGroup>
    <PackageId>Whisparr3.Net</PackageId>
    <Version>0.1.0</Version>
    <Authors>alextomas955</Authors>
    <Description>C# SDK for Whisparr 3 (Eros), generated from Whisparr's own OpenAPI spec.</Description>
    <Copyright>Copyright (c) 2026 alextomas955</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alextomas955/Whisparr3.Net</PackageProjectUrl>
    <PackageTags>whisparr;arr;openapi;sdk;rest;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Required by PackageReadmeFile. Without it, pack fails with NU5039.
       $(MSBuildThisFileDirectory) is the repo root, so this works from any project depth. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
