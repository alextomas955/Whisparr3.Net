<Project>

  <!-- Compilation. Owned here because the library csproj is generator output. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS0612: the spec's own deprecated: true on QueueResource.Sizeleft/Timeleft.
         CS1591: missing XML comments, insurance for the hand-written layer. -->
    <NoWarn>$(NoWarn);CS0612;CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Deterministic build and symbols. Deterministic already defaults to true; do not set it.
       Do not reference Microsoft.SourceLink.GitHub; it suppresses the SDK's built-in copy. -->
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- SourceLink reads origin, the only remote a clone is guaranteed to have.

       The problem this solves: origin here is the git@github.com-alex SSH alias, and the SDK
       does not recognise that host, so it emits no source map at all and ships a dead .snupkg,
       silently and with no warning. Pointing GitRepositoryRemoteName at a hand-added canonical
       remote fixed it only on the one machine where someone typed git remote add by hand; every
       clone, including the owner's second machine and CI, has only origin and got two fallback
       warnings per project per build.

       Registering the alias as a GitHub host is repo-tracked, so it works in every clone.
       Measured on SDK 10.0.400, packing this props file with each remote in turn as the only
       remote:
         origin https://github.com/...            0 warnings, source map to raw.githubusercontent.com
         origin git@github.com-alex:...           0 warnings, source map to raw.githubusercontent.com
       Without the mapping the second case emits no .sourcelink.json and writes
       url="ssh://git@github.com-alex/..." into the nuspec. -->
  <ItemGroup>
    <SourceLinkGitHubHost Include="github.com-alex" ContentUrl="https://raw.githubusercontent.com" />
  </ItemGroup>

  <!-- NuGet package metadata.

       RepositoryUrl and RepositoryType are set here rather than left to SourceLink.

       The problem this solves: SourceLink derives the nuspec repository url from origin, and
       origin here is the git@github.com-alex SSH alias, so it wrote
       url="https://github.com-alex/alextomas955/Whisparr3.Net.git" into the package. That host
       does not resolve. The SourceLinkGitHubHost mapping above fixes the source map and does not
       touch this value, and the defect was invisible from this file because it only appears in
       the produced nuspec. Setting the two properties was held off because the library csproj
       warns that a RepositoryUrl/RepositoryType pair overrides the SDK's built-in SourceLink and
       ships a .snupkg with no commit SHA. That warning was made about the generator's own csproj
       and was never measured for this file, so it was measured before it was acted on.

       Measured on SDK 10.0.400, packing this props file with and without the two properties, at
       commit ed94b04. Both packs emitted 0 warnings and both .snupkg files carried both PDBs.
         property pair absent   nuspec url https://github.com-alex/alextomas955/Whisparr3.Net.git
                                nuspec commit ed94b048, source map to raw.githubusercontent.com
         property pair present  nuspec url https://github.com/alextomas955/Whisparr3.Net
                                nuspec commit ed94b048, source map to raw.githubusercontent.com
       The commit attribute, the source map and the commit-pinned url embedded in both shipped
       PDBs are byte-identical across the two packs, so the warning does not apply here. -->
  <PropertyGroup>
    <PackageId>Whisparr3.Net</PackageId>
    <Version>0.1.0</Version>
    <Authors>alextomas955</Authors>
    <Description>C# SDK for Whisparr 3 (Eros), generated from Whisparr's own OpenAPI spec.</Description>
    <Copyright>Copyright (c) 2026 alextomas955</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alextomas955/Whisparr3.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alextomas955/Whisparr3.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>whisparr;arr;openapi;sdk;rest;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Required by PackageReadmeFile. Without it, pack fails with NU5039.
       $(MSBuildThisFileDirectory) is the repo root, so this works from any project depth. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
